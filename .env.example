# Vercel AI Gateway (authentication)
# Locally: set AI_GATEWAY_API_KEY
# On Vercel: uses OIDC automatically, no key needed
AI_GATEWAY_API_KEY=

# Chat model ID via Vercel AI Gateway
# Examples: google/gemini-3.5-flash, google/gemini-2.5-flash, openai/gpt-4o
CHAT_MODEL=google/gemini-3.5-flash

# Embedding model ID via Vercel AI Gateway
# Recommended: google/gemini-embedding-001 for Hebrew/Aramaic texts
# Alternatives: openai/text-embedding-3-small
EMBEDDING_MODEL=google/gemini-embedding-001

# Embedding vector dimensions (must match migration)
# Default: 768 (reduced from gemini-embedding-001's native 3072)
EMBEDDING_DIMENSIONS=768

# Supabase (database for vectors and texts)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
